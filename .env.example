# Ask Olaide. Copy to .env.local for local development; on Vercel, add these under Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Supabase (Project Settings → API). Optional locally: without them, limits are kept in memory and nothing is saved.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Used to hash visitor IP addresses.
ASK_IP_SALT=
# Monthly spend cap in dollars (default 20)
ASK_MONTHLY_CAP_USD=20
# Comma-separated site origins allowed to call the chat, e.g. https://olaide.design
ASK_ALLOWED_ORIGINS=
